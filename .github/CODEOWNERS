# The protocol, its schemas, profiles and config, the calibration record and
# the workflows that check them. A change to any of these is a protocol change.
# GitHub ignores a line whose owner lacks write access. The CODEOWNERS
# errors API must return {"errors": []} before this file is a real gate.

/GO_TOPS.md       @VirtualMachinist @NebuHedron
/schema/          @VirtualMachinist @NebuHedron
/profiles/        @VirtualMachinist @NebuHedron
/config/          @VirtualMachinist @NebuHedron
/calibration/     @VirtualMachinist @NebuHedron
/scripts/         @VirtualMachinist @NebuHedron
/.github/         @VirtualMachinist @NebuHedron

# The kit's code and the files that set or pin its gate. A change to any of
# these changes what the gate means, so it is reviewed like a protocol change.
/go.mod           @VirtualMachinist @NebuHedron
/go.sum           @VirtualMachinist @NebuHedron
/embed.go         @VirtualMachinist @NebuHedron
/tools/           @VirtualMachinist @NebuHedron
/cmd/             @VirtualMachinist @NebuHedron
/internal/        @VirtualMachinist @NebuHedron
/.golangci.yml    @VirtualMachinist @NebuHedron
/go-tops.yaml     @VirtualMachinist @NebuHedron
/go-tops.lock     @VirtualMachinist @NebuHedron
